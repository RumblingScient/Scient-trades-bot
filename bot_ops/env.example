# /root/scient_trades_bot/.env   (chmod 600)
SCIENT_BOT_TOKEN=paste_discord_bot_token_here
SIGMA_OPS_CHANNEL_ID=0            # BACKSTAGE ops channel id -> errors/loop crashes/feed problems get posted here
TELEGRAM_BOT_TOKEN=

# ─── Payments (SOL to a fixed wallet, chain-verified) ───
SIGMA_SOL_WALLET=                 # your Solana receiving address - the ONLY place it lives
SIGMA_SOL_RPC=https://api.mainnet-beta.solana.com   # or a Helius/QuickNode endpoint for reliability
SIGMA_PAYMENT_CHANNEL_ID=0        # #join-via-payment (informational; the panel is posted with /admin panel kind:pay)
SIGMA_MODLOG_CHANNEL_ID=0         # every grant / revoke / expiry lands here (0 = ops channel)
SIGMA_ALUMNI_ROLE_ID=0            # role given when Pro lapses (0 = off)
# plans.json is created on first boot from config.SUB_PLANS - after that, edit plans with /admin plans, not in code
